generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostType {
  PAGE
  ARTICLE
  NEWS
  ANNOUNCEMENT
  PROJECT
  LESSON
  RESEARCH
  AWARD
  ACHIEVEMENT
  GALLERY
  EVENT
  VIRTUAL_EXHIBITION
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO_LINK
  AUDIO
}

enum HomepageSectionType {
  HERO
  FEATURED_CATEGORIES
  LATEST_NEWS
  ANNOUNCEMENTS
  GALLERIES
  STUDENT_WORK
  ACHIEVEMENTS
  VIDEOS
  CUSTOM
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(EDITOR)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         Post[]

  @@map("users")
}

model SlugHistory {
  id          String   @id @default(cuid())
  oldSlug     String
  newSlug     String?
  entityType  String   // "post" or "category"
  entityId    String?
  categoryId  String?
  createdAt   DateTime @default(now())

  @@index([oldSlug])
  @@index([entityType, entityId])
  @@map("slug_history")
}

model Category {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String?
  contentType PostType?    // Suggested default content type for posts inside this category
  icon        String?
  imageId     String?
  image       Media?       @relation(fields: [imageId], references: [id], onDelete: SetNull, name: "CategoryImage")
  parentId    String?
  parent      Category?    @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]   @relation("CategoryParent")
  sortOrder   Int          @default(0)
  isVisible   Boolean      @default(true)
  showInMenu  Boolean      @default(true)
  metadata    Json?        // e.g. { grade: 4, field: "drawing" }

  posts       Post[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([parentId, sortOrder])
  @@index([isVisible, showInMenu])
  @@map("categories")
}

model Post {
  id              String       @id @default(cuid())
  title           String
  slug            String
  excerpt         String?      @db.Text
  content         String?      @db.Text
  type            PostType     @default(ARTICLE)
  status          PostStatus   @default(DRAFT)
  publishedAt     DateTime?
  authorId        String?
  author          User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImageId String?
  featuredImage   Media?       @relation(fields: [featuredImageId], references: [id], onDelete: SetNull, name: "PostFeaturedImage")

  // SEO
  metaTitle       String?
  metaDescription String?      @db.Text
  keywords        String?

  // Ordering and visibility
  sortOrder       Int          @default(0)
  isFeatured      Boolean      @default(false)
  viewCount       Int          @default(0)

  // Type-specific fields in JSON
  metadata        Json?        // e.g. { year: 1445, term: 1, grade: 4, eventDate, videoUrl, externalUrl, studentName, studentClass }

  // Soft delete
  deletedAt       DateTime?

  // Relations
  media           PostMedia[]
  attachments     PostAttachment[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([slug, categoryId])
  @@index([status, publishedAt])
  @@index([categoryId, type, status, sortOrder])
  @@index([type, status, isFeatured, sortOrder])
  @@index([deletedAt])
  @@map("posts")
}

model Media {
  id          String       @id @default(cuid())
  filename    String
  originalName String
  url         String       // relative path for local, full URL for external
  mimeType    String
  size        Int
  type        MediaType    @default(IMAGE)
  width       Int?
  height      Int?
  alt         String?
  caption     String?
  isExternal  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  posts       PostMedia[]
  attachments PostAttachment[]
  categories  Category[]     @relation(name: "CategoryImage")
  featuredFor Post[]         @relation(name: "PostFeaturedImage")

  @@index([type, createdAt])
  @@map("media")
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  caption   String?

  @@unique([postId, mediaId, sortOrder])
  @@map("post_media")
}

model PostAttachment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  label     String?
  sortOrder Int      @default(0)

  @@map("post_attachments")
}

model NavigationItem {
  id          String   @id @default(cuid())
  title       String
  url         String
  target      String?  // _blank, etc
  icon        String?
  parentId    String?
  parent      NavigationItem? @relation("NavParent", fields: [parentId], references: [id], onDelete: Cascade)
  children    NavigationItem[] @relation("NavParent")
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  location    String   @default("HEADER") // HEADER, FOOTER, MOBILE

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([location, isVisible, sortOrder])
  @@index([parentId, sortOrder])
  @@map("navigation_items")
}

model HomepageSection {
  id          String              @id @default(cuid())
  title       String
  type        HomepageSectionType
  subtitle    String?
  isVisible   Boolean             @default(true)
  sortOrder   Int                 @default(0)
  settings    Json?               // configuration per type, references to category/post IDs

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("homepage_sections")
}

model SiteSetting {
  key         String   @id
  value       String   @db.Text
  label       String?
  type        String   @default("STRING") // STRING, JSON, BOOLEAN
  isPublic    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String?
  userId      String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
