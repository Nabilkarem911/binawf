# ============================================================
#  موهبة فنان — نشر الإنتاج على أي سيرفر (Docker Compose)
# ============================================================
# 1) انسخ الملف:   cp .env.example .env
# 2) عدّل القيم الفاضية أدناه (SESSION_SECRET، POSTGRES_PASSWORD،
#    ADMIN_PASSWORD، NEXT_PUBLIC_SITE_URL) — القيم الفاضية بتفشل التشغيل عمداً.
# 3) شغّل:         docker compose up -d --build
# ============================================================

# الرابط النهائي للموقع — بيُحرق داخل الصورة وقت البناء (مهم جداً لـ sitemap)
NEXT_PUBLIC_SITE_URL=https://art.example-school.sa

# مفتاح تشفير جلسات الدخول (iron-session) — 32+ حرف عشوائي
# توليد: openssl rand -hex 32
SESSION_SECRET=

# حساب المدير الأول — بيتسجل أول تشغيل فقط على قاعدة فاضية
ADMIN_EMAIL=admin@binawf.local
# كلمة مرور قوية 12+ حرف (ممنوع القيمة الافتراضية الموثقة Binawf2026!)
# توليد: openssl rand -base64 18
ADMIN_PASSWORD=

# قاعدة البيانات (postgres جوه الشبكة الداخلية — مش مكشوف للخارج)
POSTGRES_USER=binawf
# توليد: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=binawf

# منفذ الموقع على السيرفر (افتراضي 3000)
#PORT=3000

# الحد الأقصى لحجم الرفع بالميجابايت (افتراضي 25)
#MAX_UPLOAD_MB=25

# ============================================================
#  للتركيب المباشر على Node (من غير Docker):
#    npm ci && npm run build && npm run start
#  استخدم DATABASE_URL بالأسفل بدل POSTGRES_*:
# ============================================================
#DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/binawf?schema=public
